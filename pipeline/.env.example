# Unleashed behavior pipeline — environment template.
# Copy to pipeline/.env and fill in. NEVER commit the real .env (it is gitignored).
# Placeholder values only in this file.

# --- AWS (S3 video source) ---
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET=unleashed-clips

# --- Amazon Bedrock (reserved) ---
BEDROCK_KEY_ID=your-bedrock-key-id
BEDROCK_SECRET=your-bedrock-secret
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=your-bedrock-model-id

# --- Tiger Data / TimescaleDB (per-hour time-series rows) ---
# Full libpq connection string / DSN.
TIGER_DSN=postgresql://user:password@host:5432/dbname

# --- MongoDB Atlas (per-dog contract summaries) ---
# Code reads MONGO_URI. Database is forced to "bonafide" in store_mongo.
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGO_DB=bonafide

# --- Gemini (reserved, not used in stage 1) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# --- Other service keys (reserved) ---
SUPERMEMORY_API_KEY=your-supermemory-api-key
TINYFISH_API_KEY=your-tinyfish-api-key

# --- Frontend (used by /app, not by the pipeline) ---
NEXT_PUBLIC_USER_POOL_ID=your-user-pool-id
NEXT_PUBLIC_USER_POOL_CLIENT_ID=your-user-pool-client-id

# --- Model + sampling ---
# Path to YOLO11 detection weights (downloaded by ultralytics if a bare name).
YOLO_WEIGHTS=yolo11s.pt
# COCO class id for "dog".
DOG_CLASS_ID=16
# Detection confidence threshold.
DETECTION_CONF=0.25
# Frame sampling rate (frames per second).
SAMPLE_FPS=10
# Downscale sampled frames to at most this width (px); keeps aspect ratio. 0 = off.
MAX_FRAME_WIDTH=1280
# Max gap (seconds) over which a missed dog is linearly interpolated in tracking.
MAX_INTERP_GAP_S=1.0
# Blur detection is relative to each clip's own sharpness. A frame is skipped as
# blurry when its Laplacian variance is below this fraction of the clip's median.
BLUR_REL_THRESHOLD=0.4
# Compensate for handheld camera motion before computing dog motion. 1=on, 0=off.
CAMERA_COMPENSATION=1
# Approachability "close" cutoff: box must cover more than this fraction of the frame.
CLOSE_AREA_FRAC=0.08

# --- API auth (optional Cognito JWT; leave off for the hackathon) ---
REQUIRE_AUTH=0
COGNITO_USER_POOL_ID=your-user-pool-id
COGNITO_APP_CLIENT_ID=your-app-client-id
COGNITO_REGION=us-east-1

# --- Defaults ---
DEFAULT_CAMERA_ID=cam-default
